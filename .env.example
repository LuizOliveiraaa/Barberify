# Barberify — modelo de configuração.
# Copie para .env (o instalador faz isso) e NUNCA versione o .env.

APP_ENV=producao
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_HTTPS=false
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barberify
DB_USUARIO=
DB_SENHA=
DB_SOCKET=

# Chave para recuperação emergencial do proprietário global via CLI.
OWNER_RECOVERY_KEY=

# E-mail: driver null (padrão, sem envio) | smtp
MAIL_DRIVER=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USUARIO=
MAIL_SENHA=
MAIL_FROM=nao-responda@barberify.local
MAIL_FROM_NOME=Barberify

LOGIN_MAX_TENTATIVAS=5
